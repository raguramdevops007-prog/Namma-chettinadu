
pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    environment {
        IMAGE_NAME = 'namma-chettinadu'
        CONTAINER_NAME = 'namma-restaurant'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Source') {
            steps {
                sh '''
                    test -f Namma-Chettinad-Restaurant/index.html
                    test -f Namma-Chettinad-Restaurant/Dockerfile
                    echo "Source validation successful"
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                    -f Namma-Chettinad-Restaurant/Dockerfile \
                    -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                    Namma-Chettinad-Restaurant
                '''
            }
        }

        stage('Deploy Website') {
            steps {
                sh '''
                    docker rm -f ${CONTAINER_NAME} || true

                    docker run -d \
                    --name ${CONTAINER_NAME} \
                    --restart unless-stopped \
                    -p 80:80 \
                    ${IMAGE_NAME}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    sleep 3
                    docker ps
                    curl -f http://localhost/
                    echo "Deployment successful"
                '''
            }
        }
    }
}
